{
  "name": "telegramvisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "telegramvisor": "dist/cli.js"
  },
  "scripts": {
    "autofix": "eslint src test ui/src vite.config.ts --fix",
    "lint": "eslint src test ui/src vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "build": "tsc -p tsconfig.build.json && vite build",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/main.js",
    "dev:ui": "vite build --watch"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "effect": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.18.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
